{
  "name": "onboarding-kit",
  "version": "0.3.0",
  "description": "Onboarding de projetos gerado pela sua IA local: um JSON descreve o projeto e o onboarding-kit o apresenta em /onboarding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewixGenerator/onboard-kit.git"
  },
  "homepage": "https://github.com/LewixGenerator/onboard-kit#readme",
  "bugs": {
    "url": "https://github.com/LewixGenerator/onboard-kit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "onboarding-kit": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./nest": {
      "types": "./dist/adapters/nest.d.ts",
      "default": "./dist/adapters/nest.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/adapters/node.d.ts"
      ],
      "next": [
        "./dist/adapters/next.d.ts"
      ],
      "nest": [
        "./dist/adapters/nest.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "onboarding",
    "documentation",
    "ai",
    "nextjs",
    "nestjs",
    "developer-experience"
  ],
  "peerDependencies": {
    "@nestjs/common": ">=9"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.0"
  }
}
