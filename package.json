{
  "name": "onboarding-kit",
  "version": "0.7.0",
  "description": "Onboarding de projetos JavaScript e TypeScript gerado pela sua IA local: um JSON descreve o projeto e o onboarding-kit o apresenta em /onboarding. Next, Nuxt, SvelteKit, Astro, Remix, NestJS, Express, Fastify, Koa, Hono, Vite e mais.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewixGenerator/onboard-kit.git"
  },
  "homepage": "https://github.com/LewixGenerator/onboard-kit#readme",
  "bugs": {
    "url": "https://github.com/LewixGenerator/onboard-kit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "onboarding-kit": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./nest": {
      "types": "./dist/adapters/nest.d.ts",
      "default": "./dist/adapters/nest.js"
    },
    "./fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "default": "./dist/adapters/fetch.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite.d.ts",
      "default": "./dist/adapters/vite.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./koa": {
      "types": "./dist/adapters/koa.d.ts",
      "default": "./dist/adapters/koa.js"
    },
    "./schema.json": "./dist/onboarding.schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/adapters/node.d.ts"
      ],
      "express": [
        "./dist/adapters/express.d.ts"
      ],
      "next": [
        "./dist/adapters/next.d.ts"
      ],
      "nest": [
        "./dist/adapters/nest.d.ts"
      ],
      "fetch": [
        "./dist/adapters/fetch.d.ts"
      ],
      "vite": [
        "./dist/adapters/vite.d.ts"
      ],
      "fastify": [
        "./dist/adapters/fastify.d.ts"
      ],
      "koa": [
        "./dist/adapters/koa.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.en.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-schema.js",
    "test": "npm run build && node --test",
    "test:e2e": "npm run build && playwright test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "onboarding",
    "documentation",
    "developer-experience",
    "ai",
    "claude-code",
    "cursor",
    "copilot",
    "javascript",
    "typescript",
    "nextjs",
    "nuxt",
    "sveltekit",
    "astro",
    "remix",
    "react-router",
    "nestjs",
    "express",
    "fastify",
    "koa",
    "hono",
    "elysia",
    "vite",
    "react",
    "vue",
    "svelte",
    "angular",
    "react-native",
    "electron",
    "bun",
    "deno"
  ],
  "peerDependencies": {
    "@nestjs/common": ">=9"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
